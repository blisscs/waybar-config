{
    "layer": "top",
    "position": "bottom",
    "spacing": 6,
    "height": 32,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "privacy"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "group/volume",
        "group/brightness",
        "hyprland/language",
        "custom/notification",
        "custom/weather",
        "tray",
        "power-profiles-daemon",
        "battery",
        "clock"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },
    "hyprland/language": {
        "format": "󰌌 {}",
        "min-length": 4
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 5,
        "tooltip": true
    },
    "memory": {
        "format": "󰍛 {}%",
        "interval": 5,
        "tooltip": true
    },
    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰅙 Disconnected",
        "tooltip-format": "{ipaddr}/{cidr} via {gwaddr}",
        "interval": 10
    },
    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "custom/volume-down",
            "wireplumber",
            "custom/volume-up"
        ]
    },
    "custom/volume-down": {
        "format": "−",
        "on-click": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰛩",
            "󱩎",
            "󰖨",
            "󰽨",
            "󰖙"
        ],
        "on-click": "brightnessctl set 0%",
        "on-scroll-up": "brightnessctl -s set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "group/brightness": {
        "orientation": "horizontal",
        "modules": [
            "custom/brightness-down",
            "backlight",
            "custom/brightness-up"
        ]
    },
    "custom/brightness-down": {
        "format": "−",
        "on-click": "brightnessctl set 5%-",
        "tooltip": false
    },
    "custom/brightness-up": {
        "format": "+",
        "on-click": "brightnessctl -s set +5%",
        "tooltip": false
    },
    "custom/volume-up": {
        "format": "+",
        "on-click": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "tooltip": false
    },
    "custom/notification": {
        "exec": "count=$(makoctl list 2>/dev/null | grep -c '^Notification'); if [ \"$count\" -gt 0 ]; then echo '{\"text\": \"'\"$count\"'\", \"tooltip\": \"'\"$count\"' notification(s)\", \"class\": \"has-notifs\"}'; else echo '{\"text\": \"\", \"tooltip\": \"No notifications\", \"class\": \"empty\"}'; fi",
        "return-type": "json",
        "format": "󰂚 {}",
        "interval": 3,
        "on-click": "makoctl dismiss",
        "on-click-right": "makoctl dismiss --all"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": "Application launcher",
        "on-click": "pkill wofi || wofi --show drun",
        "on-click-right": "pkill wlogout || wlogout"
    },
    "custom/weather": {
        "exec": "curl -fsS 'wttr.in/?format=%c+%t+%h' 2>/dev/null || echo ''",
        "interval": 1800,
        "tooltip": true,
        "tooltip-format": "Weather",
        "format": "{}"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        }
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂅  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": [
            "󰂎",
            "󰂂",
            "󰁺",
            "󰂁",
            "󰁹"
        ],
        "tooltip-format": "{timeTo}"
    },
    "clock": {
        "format": " {:%a %b %d  %H:%M}",
        "interval": 60,
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250
    }
}
